APP_ENV=local
APP_NAME=Barrier-Free Mobility Agent
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FORMAT=json

# Manual hosted-candidate evaluation only. Do not add this to Web or Agent runtime
# configuration; pass it only to scripts/evaluate_openai_candidate.py.
# OPENAI_API_KEY=

API_HOST=0.0.0.0
API_PORT=8080
API_REQUEST_MAX_CHARS=2000
API_OWNER_MODE=disabled
# Required when API_OWNER_MODE=trusted_header; it must match AGENT_BFF_SHARED_SECRET.
# Use a secret manager outside local demos.
API_OWNER_SHARED_SECRET=

# Next.js BFF only. Never expose these as NEXT_PUBLIC_* variables.
WEB_PORT=3000
WEB_APP_ENV=local
# Exact browser-facing origin. Leave empty for Compose to derive http://127.0.0.1:<WEB_PORT>;
# set it explicitly when using localhost or a hosted origin. Staging/production require HTTPS.
WEB_PUBLIC_ORIGIN=
# Hosted AGENT_INTERNAL_URL must use HTTPS. Set true only when a verified private network or
# service mesh protects this internal HTTP hop.
AGENT_ALLOW_PRIVATE_HTTP=false
AGENT_INTERNAL_URL=http://agent:8080
AGENT_REQUEST_TIMEOUT_MS=90000
# Set two different high-entropy values (32 bytes or more) for the Web BFF.
AGENT_BFF_SHARED_SECRET=
AGENT_ANONYMOUS_SESSION_SECRET=

AGENT_FLOW_VERSION=mobility-v2
AGENT_STATE_SCHEMA_VERSION=3
AGENT_STATE_MAX_BYTES=65536
AGENT_MAX_GRAPH_STEPS=12
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_MODEL_CALLS=2
AGENT_MAX_PARALLEL_TOOLS=4
AGENT_MAX_CLARIFICATION_CYCLES=2
AGENT_MAX_THREADS_PER_OWNER=1000
AGENT_MAX_TOTAL_THREADS=10000
AGENT_MAX_RUNS_PER_THREAD=100

PERSISTENCE_BACKEND=memory
# PostgreSQL example for a natively running Agent:
# DATABASE_URL=postgresql://mobility_agent:password@127.0.0.1:5432/mobility_agent
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=4
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_READY_TIMEOUT_SECONDS=2
DATABASE_AUTO_SETUP=true
DATABASE_AT_REST_ENCRYPTION_CONFIRMED=false
# Hosted environments also require a 16, 24, or 32 byte CHECKPOINT_ENCRYPTION_KEY.
CHECKPOINT_ENCRYPTION_KEY=
# Required when durable idempotent execution is enabled. The active payload key must
# contain exactly 32 UTF-8 bytes; previous keys support decrypt-only rotation and use a
# JSON array such as ["previous-32-byte-key-value-here"].
EXECUTION_PAYLOAD_ENCRYPTION_KEY=
EXECUTION_PAYLOAD_PREVIOUS_ENCRYPTION_KEYS=[]
# API-only HMAC root. Keep it distinct from payload and checkpoint encryption keys.
IDEMPOTENCY_HMAC_KEY=
EXECUTION_BOUNDED_WAIT_SECONDS=60
EXECUTION_POLL_INTERVAL_SECONDS=0.05
EXECUTION_WORKER_ID=auto
EXECUTION_WORKER_LEASE_SECONDS=30
EXECUTION_WORKER_HEARTBEAT_SECONDS=5
EXECUTION_WORKER_READINESS_TIMEOUT_SECONDS=15
EXECUTION_WORKER_POLL_SECONDS=0.25
EXECUTION_WORKER_MAX_ERROR_BACKOFF_SECONDS=5
EXECUTION_WORKER_SHUTDOWN_GRACE_SECONDS=30

MCP_MOBILITY_URL=http://127.0.0.1:8000/mcp
MCP_MOBILITY_HEALTH_URL=http://127.0.0.1:8000/health
MCP_MOBILITY_AUTH_MODE=none
MCP_MOBILITY_BEARER_TOKEN=
MCP_MOBILITY_OIDC_TOKEN_URL=
MCP_MOBILITY_OIDC_CLIENT_ID=
MCP_MOBILITY_OIDC_CLIENT_SECRET=
MCP_MOBILITY_OIDC_SCOPE=
MCP_MOBILITY_OIDC_REFRESH_LEEWAY_SECONDS=30
MCP_TOOL_INPUT_MAX_CHARS=120
MCP_CONNECT_TIMEOUT_SECONDS=3
MCP_TOOL_TIMEOUT_SECONDS=45
MCP_STARTUP_REQUIRED=false
MCP_CONTRACT_REFRESH_SECONDS=30
