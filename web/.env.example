# Server-only BFF configuration. Never expose these variables with a NEXT_PUBLIC_ prefix.
AGENT_INTERNAL_URL=http://127.0.0.1:8080
AGENT_REQUEST_TIMEOUT_MS=90000
WEB_APP_ENV=local
# Exact browser-facing origin. Local HTTP is allowed; staging/production require HTTPS.
# Mutations fail closed when Origin does not match this value.
WEB_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Hosted AGENT_INTERNAL_URL must use HTTPS. Set true only when a verified private network or
# service mesh protects this internal HTTP hop.
AGENT_ALLOW_PRIVATE_HTTP=false
# Generate two different high-entropy values, for example with: openssl rand -base64 48
AGENT_BFF_SHARED_SECRET=
AGENT_ANONYMOUS_SESSION_SECRET=
