{
  "name": "barrier-free-mobility-agent-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "8.5.16"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "contracts:check": "node scripts/generate-agent-types.mjs --check",
    "contracts:generate": "node scripts/generate-agent-types.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.4",
    "@stylexjs/stylex": "0.18.3",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "^28.0.0",
    "openapi-typescript": "7.13.0",
    "semver": "7.8.4",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
